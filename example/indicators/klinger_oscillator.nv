indicator(
    title: @locale { default: "Klinger Oscillator", "zh-CN": "Klinger 震荡指标", "zh-HK": "Klinger 震盪指標" },
    format: Format.Volume,
    timeframe: "",
    timeframe_gaps: true
);
var cumVol = 0.;
cumVol += nz(volume);
if bar_state.is_last and cumVol == 0 {
    runtime.error("No volume is provided by the data vendor.");
}
let sv = ta.change(hlc3) >= 0 ? volume : -volume;
let kvo = ta.ema(sv, 34) - ta.ema(sv, 55);
let sig = ta.ema(kvo, 13);
plot(kvo, color: #2962FF, title: @locale { default: "Klinger Oscillator", "zh-CN": "Klinger 震荡指标", "zh-HK": "Klinger 震盪指標" });
plot(sig, color: #43A047, title: @locale { default: "Signal", "zh-CN": "信号线", "zh-HK": "訊號線" });
