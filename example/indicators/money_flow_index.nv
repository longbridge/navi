indicator(
    title: @locale { default: "Money Flow Index", "zh-CN": "资金流量指数", "zh-HK": "資金流量指數" },
    short_title: "MFI",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);
let length = input.int(title: @locale { default: "Length", "zh-CN": "周期", "zh-HK": "週期" }, defval: 14, minval: 1, maxval: 2000);
let src = hlc3;
let mf = ta.mfi(src, length);
plot(mf, @locale { default: "MF", "zh-CN": "资金流量", "zh-HK": "資金流量" }, color: #7E57C2);
let overbought = hline(80, title: @locale { default: "Overbought", "zh-CN": "超买", "zh-HK": "超買" }, color: #787B86);
hline(50, @locale { default: "Middle Band", "zh-CN": "中轨", "zh-HK": "中軌" }, color: Color.new(#787B86, 50));
let oversold = hline(20, title: @locale { default: "Oversold", "zh-CN": "超卖", "zh-HK": "超賣" }, color: #787B86);
fill(
    overbought,
    oversold,
    color: Color.rgb(126, 87, 194, 90),
    title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" }
);
