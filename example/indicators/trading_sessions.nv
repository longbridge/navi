    "New York",
    @locale { default: "Displayed name", "zh-CN": "显示名称", "zh-HK": "顯示名稱" },
    group: THIRD_SESSION_GROUP,
    display: PlotDisplay.NONE,
    active: showThird
);
let thirdSessionTime = input.session(
    "0930-1600",
    @locale { default: "Session time", "zh-CN": "时段时间", "zh-HK": "時段時間" },
    group: THIRD_SESSION_GROUP,
    display: PlotDisplay.NONE,
    active: showThird
);
let thirdSessionTZ = input.string(
    "America/New_York",
    @locale { default: "Session timezone", "zh-CN": "时段时区", "zh-HK": "時段時區" },
    group: THIRD_SESSION_GROUP,
    display: PlotDisplay.NONE,
    tooltip: TZ_TOOLTIP_TEXT,
    active: showThird
);
let thirdSessionColor = input.color(
    Color.new(#089981, 85),
    @locale { default: "Session color", "zh-CN": "时段颜色", "zh-HK": "時段顏色" },
    group: THIRD_SESSION_GROUP,
    active: showThird
);

struct SessionDisplay {
    sessionBox: Box,
    sessionLabel: Label,
    openLine: Line,
    avgLine: Line,
    closeLine: Line,
    sumClose: float,
    numOfBars: int,
}

struct SessionInfo {
    color: Color,
    name: String,
    session: String,
    timezone: String,
    active: SessionDisplay = na,
}

method setName(this: SessionDisplay, name: String) {
    let sessionLabel = this.sessionLabel;
    let sessionBox = this.sessionBox;
    let boxText = Array.new<String>();
    if showSessionTickRange {
        boxText.push(
            "Range: " + String.from((sessionBox.get_top() - sessionBox.get_bottom()) / symbol_info.min_tick, Format.Mintick)
        );
    }
    if showSessionAverage {
        boxText.push(
            "Avg: " + String.from(this.sumClose / this.numOfBars, Format.Mintick)
        );
    }
    if showSessionNames {
        boxText.push(name);
    }
    sessionLabel.set_y(sessionBox.get_bottom());
    sessionLabel.set_text(boxText.join("\n"));
}

method createSessionDisplay(this: SessionInfo) {
    let boxColor = this.color;
    let opaqueColor = Color.new(boxColor, 0);
    let dis = SessionDisplay.new(
        sessionBox: Box.new(
            bar_index,
            high,
            bar_index,
            low,
            bg_color: boxColor,
            border_color: na
        ),
        sessionLabel: Label.new(
            bar_index,
            low,
            "",
            style: LabelStyle.UpperLeft,
            text_align: TextHAlign.Left,
            text_color: opaqueColor,
            color: na
        ),
        openLine: showSessionOC ? Line.new(
            bar_index,
            open,
            bar_index,
            open,
            color: opaqueColor,
            style: LineStyle.Dashed,
            width: 1
        ) : na,
        closeLine: showSessionOC ? Line.new(
            bar_index,
            close,
            bar_index,
            close,
            color: opaqueColor,
            style: LineStyle.Dashed,
            width: 1
        ) : na,
        avgLine: showSessionAverage ? Line.new(
            bar_index,
            close,
            bar_index,
            close,
            style: LineStyle.Dotted,
            width: 2,
            color: opaqueColor
        ) : na,
        sumClose: close,
        numOfBars: 1
    );
    LineFill.new(dis.openLine, dis.closeLine, boxColor);
    dis.setName(this.name);
    this.active = dis;
}

method updateSessionDisplay(this: SessionInfo) {
    let sessionDisp = this.active;
    let sessionBox = sessionDisp.sessionBox;
    let openLine = sessionDisp.openLine;
    let closeLine = sessionDisp.closeLine;
    let avgLine = sessionDisp.avgLine;
    sessionDisp.sumClose += close;
    sessionDisp.numOfBars += 1;
    sessionBox.set_top(math.max(sessionBox.get_top(), high));
    sessionBox.set_bottom(math.min(sessionBox.get_bottom(), low));
    sessionBox.set_right(bar_index);
    sessionDisp.setName(this.name);
    if showSessionOC {
        openLine.set_x2(bar_index);
        closeLine.set_x2(bar_index);
        closeLine.set_y1(close);
        closeLine.set_y2(close);
    }
    if showSessionAverage {
        avgLine.set_x2(bar_index);
        let avg = sessionDisp.sumClose / sessionDisp.numOfBars;
        avgLine.set_y1(avg);
        avgLine.set_y2(avg);
    }
    sessionDisp;
}

method update(this: SessionInfo) {
    let isChange: bool = timeframe.change("1D");
    if (not na(time("", this.session, this.timezone))) {
        if na(this.active) or isChange {
            this.createSessionDisplay();
        } else {
            this.updateSessionDisplay();
        }
    } else if not na(this.active) {
        this.active = na;
    }
}

fn getSessionInfos() {
    let sessionInfos: Array<SessionInfo> = Array.new<SessionInfo>();
    if showFirst {
        sessionInfos.push(
            SessionInfo.new(
                firstSessionColor,
                firstSessionName,
                firstSessionTime,
                firstSessionTZ
            )
        );
    }
    if showSecond {
        sessionInfos.push(
            SessionInfo.new(
                secondSessionColor,
                secondSessionName,
                secondSessionTime,
                secondSessionTZ
            )
        );
    }
    if showThird {
        sessionInfos.push(
            SessionInfo.new(
                thirdSessionColor,
                thirdSessionName,
                thirdSessionTime,
                thirdSessionTZ
            )
        );
    }
    sessionInfos;
}

var sessionInfos: Array<SessionInfo> = getSessionInfos();
if timeframe.is_dwm {
    runtime.error("This indicator can only be used on intraday timeframes.");
}

for info in sessionInfos {
    info.update();
}
