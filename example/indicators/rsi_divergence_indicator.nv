indicator(
    title: @locale { default: "RSI Divergence Indicator", "zh-CN": "RSI 背离指标", "zh-HK": "RSI 背離指標" },
    format: Format.Price,
    timeframe: "",
    timeframe_gaps: true
);
let len = input.int(title: @locale { default: "RSI Period", "zh-CN": "RSI 周期", "zh-HK": "RSI 週期" }, minval: 1, defval: 14);
let src = input(title: @locale { default: "RSI Source", "zh-CN": "RSI 数据源", "zh-HK": "RSI 數據源" }, defval: close);
let lbR = input(
    title: @locale { default: "Pivot Lookback Right", "zh-CN": "枢轴右侧回溯", "zh-HK": "樞軸右側回溯" },
    defval: 5,
    display: PlotDisplay.NONE
);
let lbL = input(title: @locale { default: "Pivot Lookback Left", "zh-CN": "枢轴左侧回溯", "zh-HK": "樞軸左側回溯" }, defval: 5, display: PlotDisplay.NONE);
let rangeUpper = input(
    title: @locale { default: "Max of Lookback Range", "zh-CN": "回溯范围上限", "zh-HK": "回溯範圍上限" },
    defval: 60,
    display: PlotDisplay.NONE
);
let rangeLower = input(
    title: @locale { default: "Min of Lookback Range", "zh-CN": "回溯范围下限", "zh-HK": "回溯範圍下限" },
    defval: 5,
    display: PlotDisplay.NONE
);
let plotBull = input(
    title: @locale { default: "Plot Bullish", "zh-CN": "显示看涨背离", "zh-HK": "顯示看漲背離" },
    defval: true,
    display: PlotDisplay.NONE
);
let plotHiddenBull = input(
    title: @locale { default: "Plot Hidden Bullish", "zh-CN": "显示隐藏看涨背离", "zh-HK": "顯示隱藏看漲背離" },
    defval: false,
    display: PlotDisplay.NONE
);
let plotBear = input(
    title: @locale { default: "Plot Bearish", "zh-CN": "显示看跌背离", "zh-HK": "顯示看跌背離" },
    defval: true,
    display: PlotDisplay.NONE
);
let plotHiddenBear = input(
    title: @locale { default: "Plot Hidden Bearish", "zh-CN": "显示隐藏看跌背离", "zh-HK": "顯示隱藏看跌背離" },
    defval: false,
    display: PlotDisplay.NONE
);
let bearColor = Color.RED;
let bullColor = Color.GREEN;
let hiddenBullColor = Color.new(Color.GREEN, 80);
let hiddenBearColor = Color.new(Color.RED, 80);
let textColor = Color.WHITE;
let noneColor = Color.new(Color.WHITE, 100);
let osc = ta.rsi(src, len);

plot(osc, title: @locale { default: "RSI", "zh-CN": "RSI", "zh-HK": "RSI" }, line_width: 2, color: #2962FF);
hline(50, title: @locale { default: "Middle line", "zh-CN": "中线", "zh-HK": "中線" }, color: #787B86, line_style: HLineStyle.Dotted);
let obLevel = hline(
    70,
    title: @locale { default: "Overbought", "zh-CN": "超买", "zh-HK": "超買" },
    color: #787B86,
    line_style: HLineStyle.Dotted
);
let osLevel = hline(
    30,
    title: @locale { default: "Oversold", "zh-CN": "超卖", "zh-HK": "超賣" },
    color: #787B86,
    line_style: HLineStyle.Dotted
);
fill(obLevel, osLevel, title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" }, color: Color.rgb(33, 150, 243, 90));

let plFound = na(ta.pivot_low(osc, lbL, lbR)) ? false : true;
let phFound = na(ta.pivot_high(osc, lbL, lbR)) ? false : true;
fn _inRange(cond) {
    let bars = ta.bars_since(cond == true);
    rangeLower <= bars and bars <= rangeUpper;
}

let inRangePl = _inRange(plFound[1]);
let oscHL = osc[lbR] > ta.value_when(plFound, osc[lbR], 1) and inRangePl;

let priceLL = low[lbR] < ta.value_when(plFound, low[lbR], 1);
let bullCondAlert = priceLL and oscHL and plFound;
let bullCond = plotBull and bullCondAlert;

plot(
    plFound ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Regular Bullish", "zh-CN": "常规看涨背离", "zh-HK": "常規看漲背離" },
    line_width: 2,
    color: (bullCond ? bullColor : noneColor),
    display: PlotDisplay.PANE,
    editable: plotBull
);

plot_shape(
    bullCond ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Regular Bullish label", "zh-CN": "常规看涨背离标签", "zh-HK": "常規看漲背離標籤" },
    text: @locale { default: " Bull ", "zh-CN": " 涨 ", "zh-HK": " 漲 " },
    style: Shape.LabelUp,
    location: Location.Absolute,
    color: bullColor,
    text_color: textColor,
    editable: plotBull
);

let oscLL = osc[lbR] < ta.value_when(plFound, osc[lbR], 1) and inRangePl;

let priceHL = low[lbR] > ta.value_when(plFound, low[lbR], 1);
let hiddenBullCondAlert = priceHL and oscLL and plFound;
let hiddenBullCond = plotHiddenBull and hiddenBullCondAlert;

plot(
    plFound ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Hidden Bullish", "zh-CN": "隐藏看涨背离", "zh-HK": "隱藏看漲背離" },
    line_width: 2,
    color: (hiddenBullCond ? hiddenBullColor : noneColor),
    display: PlotDisplay.PANE,
    editable: plotHiddenBull
);

plot_shape(
    hiddenBullCond ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Hidden Bullish label", "zh-CN": "隐藏看涨背离标签", "zh-HK": "隱藏看漲背離標籤" },
    text: @locale { default: " H Bull ", "zh-CN": " 隐涨 ", "zh-HK": " 隱漲 " },
    style: Shape.LabelUp,
    location: Location.Absolute,
    color: bullColor,
    text_color: textColor,
    editable: plotHiddenBull
);

let inRangePh = _inRange(phFound[1]);
let oscLH = osc[lbR] < ta.value_when(phFound, osc[lbR], 1) and inRangePh;

let priceHH = high[lbR] > ta.value_when(phFound, high[lbR], 1);

let bearCondAlert = priceHH and oscLH and phFound;
let bearCond = plotBear and bearCondAlert;

plot(
    phFound ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Regular Bearish", "zh-CN": "常规看跌背离", "zh-HK": "常規看跌背離" },
    line_width: 2,
    color: (bearCond ? bearColor : noneColor),
    display: PlotDisplay.PANE,
    editable: plotBear
);

plot_shape(
    bearCond ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Regular Bearish label", "zh-CN": "常规看跌背离标签", "zh-HK": "常規看跌背離標籤" },
    text: @locale { default: " Bear ", "zh-CN": " 跌 ", "zh-HK": " 跌 " },
    style: Shape.LabelDown,
    location: Location.Absolute,
    color: bearColor,
    text_color: textColor,
    editable: plotBear
);

let oscHH = osc[lbR] > ta.value_when(phFound, osc[lbR], 1) and inRangePh;

let priceLH = high[lbR] < ta.value_when(phFound, high[lbR], 1);

let hiddenBearCondAlert = priceLH and oscHH and phFound;
let hiddenBearCond = plotHiddenBear and hiddenBearCondAlert;

plot(
    phFound ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Hidden Bearish", "zh-CN": "隐藏看跌背离", "zh-HK": "隱藏看跌背離" },
    line_width: 2,
    color: (hiddenBearCond ? hiddenBearColor : noneColor),
    display: PlotDisplay.PANE,
    editable: plotHiddenBear
);

plot_shape(
    hiddenBearCond ? osc[lbR] : na,
    offset: -lbR,
    title: @locale { default: "Hidden Bearish label", "zh-CN": "隐藏看跌背离标签", "zh-HK": "隱藏看跌背離標籤" },
    text: @locale { default: " H Bear ", "zh-CN": " 隐跌 ", "zh-HK": " 隱跌 " },
    style: Shape.LabelDown,
    location: Location.Absolute,
    color: bearColor,
    text_color: textColor,
    editable: plotHiddenBear
);

alert_condition(
    bullCondAlert,
    title: @locale { default: "Regular Bullish Divergence", "zh-CN": "常规看涨背离", "zh-HK": "常規看漲背離" },
    message: @locale {
        default: "Found a new Regular Bullish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar",
        "zh-CN": "发现新的常规看涨背离，位于当前K线左侧「枢轴右侧回溯」根K线处",
        "zh-HK": "發現新的常規看漲背離，位於當前K線左側「樞軸右側回溯」根K線處",
    }
);
alert_condition(
    hiddenBullCondAlert,
    title: @locale { default: "Hidden Bullish Divergence", "zh-CN": "隐藏看涨背离", "zh-HK": "隱藏看漲背離" },
    message: @locale {
        default: "Found a new Hidden Bullish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar",
        "zh-CN": "发现新的隐藏看涨背离，位于当前K线左侧「枢轴右侧回溯」根K线处",
        "zh-HK": "發現新的隱藏看漲背離，位於當前K線左側「樞軸右側回溯」根K線處",
    }
);
alert_condition(
    bearCondAlert,
    title: @locale { default: "Regular Bearish Divergence", "zh-CN": "常规看跌背离", "zh-HK": "常規看跌背離" },
    message: @locale {
        default: "Found a new Regular Bearish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar",
        "zh-CN": "发现新的常规看跌背离，位于当前K线左侧「枢轴右侧回溯」根K线处",
        "zh-HK": "發現新的常規看跌背離，位於當前K線左側「樞軸右側回溯」根K線處",
    }
);
alert_condition(
    hiddenBearCondAlert,
    title: @locale { default: "Hidden Bearish Divergence", "zh-CN": "隐藏看跌背离", "zh-HK": "隱藏看跌背離" },
    message: @locale {
        default: "Found a new Hidden Bearish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar",
        "zh-CN": "发现新的隐藏看跌背离，位于当前K线左侧「枢轴右侧回溯」根K线处",
        "zh-HK": "發現新的隱藏看跌背離，位於當前K線左側「樞軸右側回溯」根K線處",
    }
);
