indicator(@locale { default: "Gaps", "zh-CN": "缺口", "zh-HK": "缺口" }, overlay: true, max_boxes_count: 500);

let closeGapsPartially = input.bool(
    false,
    @locale { default: "Close Gaps Partially", "zh-CN": "部分关闭缺口", "zh-HK": "部分關閉缺口" },
    display: PlotDisplay.NONE
);
let boxLimitInput = input.int(
    15,
    @locale { default: "Max Number of Gaps", "zh-CN": "最大缺口数量", "zh-HK": "最大缺口數量" },
    minval: 1,
    maxval: 500,
    display: PlotDisplay.NONE
);
let minimalDeviationTooltip = @locale {
    default: "Specifies the minimal size of detected gaps, as a percentage of the average high-low range for the last 14 bars.",
    "zh-CN": "指定检测到的缺口的最小尺寸，以过去14根K线的平均高低范围的百分比表示。",
    "zh-HK": "指定偵測到的缺口的最小尺寸，以過去14根K線的平均高低範圍的百分比表示。",
};
let minimalDeviationInput = nz(
    input.float(
        30.0,
        @locale { default: "Minimal Deviation (%)", "zh-CN": "最小偏差 (%)", "zh-HK": "最小偏差 (%)" },
        tooltip: minimalDeviationTooltip,
        minval: 1,
        maxval: 100,
        display: PlotDisplay.NONE
    ) / 100 * ta.sma(high - low, 14)
);
let limitBoxLengthBoolInput = input.bool(
    false,
    @locale { default: "Limit Max Gap Trail Length (bars)", "zh-CN": "限制最大缺口追踪长度（K线数）", "zh-HK": "限制最大缺口追蹤長度（K線數）" },
    inline: "Length Limit",
    display: PlotDisplay.NONE
);
let limitBoxLengthIntInput = input.int(
    300,
    "",
    inline: "Length Limit",
    minval: 1,
    display: PlotDisplay.NONE,
    active: limitBoxLengthBoolInput
);

let groupName = @locale { default: "Border and fill colors", "zh-CN": "边框和填充颜色", "zh-HK": "邊框和填充顏色" };
let colorUpBorderInput = input.color(
    Color.GREEN,
    @locale { default: "Up Gaps", "zh-CN": "上升缺口", "zh-HK": "上升缺口" },
    inline: "Gap Up",
    group: groupName,
    display: PlotDisplay.NONE
);
let colorUpBackgroundInput = input.color(
    Color.new(Color.GREEN, 85),
    "",
    inline: "Gap Up",
    group: groupName,
    display: PlotDisplay.NONE
);
let colorDownBorderInput = input.color(
    Color.RED,
    @locale { default: "Down Gaps", "zh-CN": "下降缺口", "zh-HK": "下降缺口" },
    inline: "Gap Down",
    group: groupName,
    display: PlotDisplay.NONE
);
let colorDownBackgroundInput = input.color(
    Color.new(Color.RED, 85),
    "",
    inline: "Gap Down",
    group: groupName,
    display: PlotDisplay.NONE
);

struct AlertInfo {
    countOpenGap: int,
    countClosedGap: int,
}

method hasOpenedGap(this: AlertInfo) {
    this.countOpenGap > 0;
}

method hasClosedGap(this: AlertInfo) {
    this.countClosedGap > 0;
}

let alertInfo: AlertInfo = AlertInfo.new(0, 0);

struct Gap {
    isActive: bool,
    isBull: bool,
    boxes: Array<Box>,
}

method delete(this: Gap) {
    for _box in this.boxes {
        _box.delete();
    }
}

method partialClose(this: Gap) {
    let activeBox = this.boxes.last();
    activeBox.set_extend(Extend.None);
    let top = this.isBull ? activeBox.get_top() : low;
    let bottom = this.isBull ? high : activeBox.get_bottom();
    this.boxes.push(
        Box.new(
            bar_index,
            top,
            bar_index,
            bottom,
            this.isBull ? colorDownBorderInput : colorUpBorderInput,
            bg_color: this.isBull ? colorDownBackgroundInput : colorUpBackgroundInput
        )
    );
}

method fullClose(this: Gap) {
    alertInfo.countClosedGap += 1;
    let activeBox = this.boxes.last();
    activeBox.set_extend(Extend.None);
    this.isActive = false;
    if closeGapsPartially {
        activeBox.delete();
    }
}

method checkForClose(this: Gap) {
    if this.isActive {
        let activeBox = this.boxes.last();
        let top = activeBox.get_top();
        let bot = activeBox.get_bottom();
        let isBull = this.isBull;
        activeBox.set_right(bar_index);
        if (high > bot and isBull) or (low < top and not isBull) {
            if closeGapsPartially {
                this.partialClose();
            } else {
                this.fullClose();
            }
        }
        let forceCloseBoxExceededLengthLimit: bool = (limitBoxLengthBoolInput and bar_index - activeBox.get_left() >= limitBoxLengthIntInput);
        if ((high > top and isBull) or (low < bot and not isBull)) or forceCloseBoxExceededLengthLimit {
            this.fullClose();
        }
    }
}

var allGaps = Array.new<Gap>();

let isGapDown = high < low[1] and low[1] - high >= minimalDeviationInput;
let isGapUp = low > high[1] and low - high[1] >= minimalDeviationInput;
let isGap = isGapDown or isGapUp;
let boxBorderColor = isGapDown ? colorDownBorderInput : colorUpBorderInput;
let boxBgcolor = isGapDown ? colorDownBackgroundInput : colorUpBackgroundInput;

fn registerNewGap(isGapDown: bool) {
    alertInfo.countOpenGap += 1;
    let newBox = Box.new(
        bar_index - 1,
        (isGapDown ? low[1] : low),
        bar_index,
        (isGapDown ? high : high[1]),
        border_color: boxBorderColor,
        bg_color: boxBgcolor,
        extend: Extend.Right
    );
    allGaps.push(Gap.new(true, isGapDown, Array.from(newBox)));
    if allGaps.size() > boxLimitInput {
        allGaps.shift().delete();
    }
}

for gap in allGaps {
    gap.checkForClose();
}

if isGap {
    registerNewGap(isGapDown);
}

if bar_state.is_last_confirmed_history and allGaps.size() == 0 {
    let noGapText = @locale {
        default: "No gaps found on the current chart. \n The cause could be that some exchanges align the open of new bars on the close of the previous one, resulting in charts with no gaps. Alternatively, your Minimal Deviation might be too high.",
        "zh-CN": "当前图表未发现缺口。\n 原因可能是某些交易所将新K线的开盘价与前一根K线的收盘价对齐，导致图表中没有缺口。或者，您设置的最小偏差可能过高。",
        "zh-HK": "當前圖表未發現缺口。\n 原因可能是某些交易所將新K線的開盤價與前一根K線的收盤價對齊，導致圖表中沒有缺口。或者，您設定的最小偏差可能過高。",
    };
    var infoTable = Table.new(Position.BottomRight, 1, 1);
    Table.cell(
        infoTable,
        0,
        0,
        text: noGapText,
        text_color: chart.bg_color,
        bg_color: chart.fg_color
    );
}

alert_condition(
    alertInfo.hasOpenedGap(),
    @locale { default: "New Gap Appeared", "zh-CN": "新缺口出现", "zh-HK": "新缺口出現" },
    @locale { default: "A new gap has appeared.", "zh-CN": "出现了一个新的缺口。", "zh-HK": "出現了一個新的缺口。" }
);
alert_condition(
    alertInfo.hasClosedGap(),
    @locale { default: "Gap Closed", "zh-CN": "缺口已关闭", "zh-HK": "缺口已關閉" },
    @locale { default: "A gap was closed.", "zh-CN": "一个缺口已关闭。", "zh-HK": "一個缺口已關閉。" }
);
