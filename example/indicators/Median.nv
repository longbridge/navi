indicator(title: @locale { default: "Median", "zh-CN": "中位数", "zh-HK": "中位數" }, overlay: true, timeframe: "", timeframe_gaps: true);
let source = input(hl2, title: @locale { default: "Median Source", "zh-CN": "中位数来源", "zh-HK": "中位數來源" });
let length = input(3, title: @locale { default: "Median Length", "zh-CN": "中位数周期", "zh-HK": "中位數週期" });
let atr_length = input(14, title: @locale { default: "ATR Length", "zh-CN": "ATR 周期", "zh-HK": "ATR 週期" });
let atr_mult = input(2, title: @locale { default: "ATR Multiplier", "zh-CN": "ATR 倍数", "zh-HK": "ATR 倍數" });

let median = ta.percentile_nearest_rank(source, length, 50);
let median_plot = plot(median, color: Color.RED, line_width: 3, title: @locale { default: "Median", "zh-CN": "中位数", "zh-HK": "中位數" });

let atr_ = atr_mult * ta.atr(atr_length);

plot(median + atr_, color: Color.LIME, title: @locale { default: "Upper Band", "zh-CN": "上轨", "zh-HK": "上軌" });
plot(median - atr_, color: Color.FUCHSIA, title: @locale { default: "Lower Band", "zh-CN": "下轨", "zh-HK": "下軌" });

let median_ema = ta.ema(median, length);
let ema_plot = plot(median_ema, color: Color.BLUE, title: @locale { default: "Median EMA", "zh-CN": "中位数 EMA", "zh-HK": "中位數 EMA" });

fill(
    median_plot,
    ema_plot,
    title: @locale { default: "Fill color", "zh-CN": "填充颜色", "zh-HK": "填充顏色" },
    color: median > median_ema ? Color.new(Color.LIME, 10) : Color.new(
        Color.FUCHSIA,
        10
    )
);
