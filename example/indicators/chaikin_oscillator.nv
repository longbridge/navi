indicator(
    title: @locale { default: "Chaikin Oscillator", "zh-CN": "蔡金振荡器", "zh-HK": "蔡金振盪器" },
    short_title: "Chaikin Osc",
    format: Format.Volume,
    timeframe: "",
    timeframe_gaps: true
);
var cumVol = 0.;
cumVol += nz(volume);
if bar_state.is_last and cumVol == 0 {
    runtime.error("No volume is provided by the data vendor.");
}
let short = input.int(3, minval: 1, title: @locale { default: "Fast Length", "zh-CN": "快线周期", "zh-HK": "快線週期" });
let long = input.int(10, minval: 1, title: @locale { default: "Slow Length", "zh-CN": "慢线周期", "zh-HK": "慢線週期" });
let osc = ta.ema(ta.accdist, short) - ta.ema(ta.accdist, long);
plot(osc, title: @locale { default: "Chaikin Oscillator", "zh-CN": "蔡金振荡器", "zh-HK": "蔡金振盪器" }, color: #EC407A);
hline(0, title: @locale { default: "Zero", "zh-CN": "零线", "zh-HK": "零線" }, color: #787B86, line_style: HLineStyle.Dashed);
