indicator(
    @locale { default: "True Strength Index", "zh-CN": "真实强弱指标", "zh-HK": "真實強弱指標" },
    short_title: "TSI",
    format: Format.Price,
    precision: 4,
    timeframe: "",
    timeframe_gaps: true
);
let long = input(title: @locale { default: "Long Length", "zh-CN": "长周期", "zh-HK": "長週期" }, defval: 25);
let short = input(title: @locale { default: "Short Length", "zh-CN": "短周期", "zh-HK": "短週期" }, defval: 13);
let signal = input(title: @locale { default: "Signal Length", "zh-CN": "信号周期", "zh-HK": "信號週期" }, defval: 13);
let price = close;
fn double_smooth(src, long, short) {
    let fist_smooth = ta.ema(src, long);
    ta.ema(fist_smooth, short);
}
let pc = ta.change(price);
let double_smoothed_pc = double_smooth(pc, long, short);
let double_smoothed_abs_pc = double_smooth(math.abs(pc), long, short);
let tsi_value = 100 * (double_smoothed_pc / double_smoothed_abs_pc);
plot(tsi_value, title: @locale { default: "True Strength Index", "zh-CN": "真实强弱指标", "zh-HK": "真實強弱指標" }, color: #2962FF);
plot(ta.ema(tsi_value, signal), title: @locale { default: "Signal", "zh-CN": "信号", "zh-HK": "信號" }, color: #E91E63);
hline(0, title: @locale { default: "Zero", "zh-CN": "零线", "zh-HK": "零線" }, color: #787B86);
