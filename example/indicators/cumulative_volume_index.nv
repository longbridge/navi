indicator(@locale { default: "Cumulative Volume Index", "zh-CN": "累计成交量指标", "zh-HK": "累計成交量指標" }, "CVI", format: Format.Volume);
// Advancing minus declining volume, accumulated. Both feeds are US market
// breadth, so they carry the `.US` suffix like any other US symbol.
let adv = request.security("UPVOL.US", timeframe.period, close);
let dec = request.security("DNVOL.US", timeframe.period, close);
let cvi = ta.cum(adv - dec);
plot(cvi, "CVI");
