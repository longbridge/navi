indicator(
    title: @locale { default: "Chande Kroll Stop", "zh-CN": "Chande Kroll 止损", "zh-HK": "Chande Kroll 止損" },
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);
let p = input.int(10, minval: 1, title: @locale { default: "ATR Length (p)", "zh-CN": "ATR 周期 (p)", "zh-HK": "ATR 週期 (p)" });
let x = input.int(1, minval: 1, title: @locale { default: "ATR Coefficient (x)", "zh-CN": "ATR 系数 (x)", "zh-HK": "ATR 係數 (x)" });
let q = input.int(9, minval: 1, title: @locale { default: "Stop Length (q)", "zh-CN": "止损周期 (q)", "zh-HK": "止損週期 (q)" });
let first_high_stop = ta.highest(high, p) - x * ta.atr(p);
let first_low_stop = ta.lowest(low, p) + x * ta.atr(p);
let stop_short = ta.highest(first_high_stop, q);
let stop_long = ta.lowest(first_low_stop, q);
plot(stop_long, color: #2962FF, title: @locale { default: "Stop Long", "zh-CN": "多头止损", "zh-HK": "多頭止損" });
plot(stop_short, color: #FF6D00, title: @locale { default: "Stop Short", "zh-CN": "空头止损", "zh-HK": "空頭止損" });
