indicator(
    title: @locale { default: "Ease of Movement", "zh-CN": "移动便利性", "zh-HK": "移動便利性" },
    short_title: "EOM",
    format: Format.Volume,
    timeframe: "",
    timeframe_gaps: true
);
var cumVol = 0.;
cumVol += nz(volume);
if bar_state.is_last and cumVol == 0 {
    runtime.error("No volume is provided by the data vendor.");
}
let length = input.int(14, minval: 1);
let div = input.int(10000, title: @locale { default: "Divisor", "zh-CN": "除数", "zh-HK": "除數" }, minval: 1);
let eom = ta.sma(div * ta.change(hl2) * (high - low) / volume, length);
plot(eom, @locale { default: "EOM", "zh-CN": "移动便利性", "zh-HK": "移動便利性" }, color: #43A047);
