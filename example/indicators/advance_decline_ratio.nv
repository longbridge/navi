indicator(
    title: @locale { default: "Advance Decline Ratio", "zh-CN": "涨跌比率", "zh-HK": "升跌比率" },
    short_title: "ADR",
    format: Format.Price,
    precision: 2
);
fn ratio(t1, t2, source) {
    request.security(t1, timeframe.period, source) / request.security(
        t2,
        timeframe.period,
        source
    );
}
plot(ratio("USI:ADVN.NY", "USI:DECL.NY", close));
