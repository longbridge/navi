indicator(
    title: @locale { default: "Relative Strength Index", "zh-CN": "相对强弱指数", "zh-HK": "相對強弱指數" },
    short_title: "RSI",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);

let rsiLengthInput = input.int(
    14,
    minval: 1,
    title: @locale { default: "RSI Length", "zh-CN": "RSI 周期", "zh-HK": "RSI 週期" },
    group: @locale { default: "RSI Settings", "zh-CN": "RSI 设置", "zh-HK": "RSI 設置" }
);
let rsiSourceInput = input.source(
    close,
    @locale { default: "Source", "zh-CN": "数据源", "zh-HK": "數據源" },
    group: @locale { default: "RSI Settings", "zh-CN": "RSI 设置", "zh-HK": "RSI 設置" }
);
let calculateDivergence = input.bool(
    false,
    title: @locale { default: "Calculate Divergence", "zh-CN": "计算背离", "zh-HK": "計算背離" },
    group: @locale { default: "RSI Settings", "zh-CN": "RSI 设置", "zh-HK": "RSI 設置" },
    display: PlotDisplay.NONE,
    tooltip: @locale {
        default: "Calculating divergences is needed in order for divergence alerts to fire.",
        "zh-CN": "需要启用背离计算，背离警报才能触发。",
        "zh-HK": "需要啟用背離計算，背離警報才能觸發。",
    }
);

let change = ta.change(rsiSourceInput);
let up = ta.rma(math.max(change, 0), rsiLengthInput);
let down = ta.rma(-math.min(change, 0), rsiLengthInput);
let rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down));

let rsiPlot = plot(rsi, "RSI", color: #7E57C2);
let rsiUpperBand = hline(70, @locale { default: "RSI Upper Band", "zh-CN": "RSI 超买线", "zh-HK": "RSI 超買線" }, color: #787B86);
let midline = hline(50, @locale { default: "RSI Middle Band", "zh-CN": "RSI 中线", "zh-HK": "RSI 中線" }, color: Color.new(#787B86, 50));
let rsiLowerBand = hline(30, @locale { default: "RSI Lower Band", "zh-CN": "RSI 超卖线", "zh-HK": "RSI 超賣線" }, color: #787B86);
fill(
    rsiUpperBand,
    rsiLowerBand,
    color: Color.rgb(126, 87, 194, 90),
    title: @locale { default: "RSI Background Fill", "zh-CN": "RSI 背景填充", "zh-HK": "RSI 背景填充" }
);
let midLinePlot = plot(50, color: na, editable: false, display: PlotDisplay.NONE);
fill(
    rsiPlot,
    midLinePlot,
    100,
    70,
    top_color: Color.new(Color.GREEN, 0),
    bottom_color: Color.new(Color.GREEN, 100),
    title: @locale { default: "Overbought Gradient Fill", "zh-CN": "超买渐变填充", "zh-HK": "超買漸變填充" }
);
fill(
    rsiPlot,
    midLinePlot,
    30,
    0,
    top_color: Color.new(Color.RED, 100),
    bottom_color: Color.new(Color.RED, 0),
    title: @locale { default: "Oversold Gradient Fill", "zh-CN": "超卖渐变填充", "zh-HK": "超賣漸變填充" }
);

let GRP = @locale { default: "Smoothing", "zh-CN": "平滑处理", "zh-HK": "平滑處理" };
let TT_BB = @locale {
    default: "Only applies when 'SMA + Bollinger Bands' is selected. Determines the distance between the SMA and the bands.",
    "zh-CN": '仅在选择"SMA + 布林带"时生效，用于设定 SMA 与布林带之间的距离。',
    "zh-HK": "僅在選擇「SMA + 布林帶」時生效，用於設定 SMA 與布林帶之間的距離。",
};
let maTypeInput = input.string(
    "SMA",
    @locale { default: "Type", "zh-CN": "类型", "zh-HK": "類型" },
    options: [
        "None",
        "SMA",
        "SMA + Bollinger Bands",
        "EMA",
        "SMMA (RMA)",
        "WMA",
        "VWMA"
    ],
    group: GRP,
    display: PlotDisplay.NONE
);
var isBB = maTypeInput == "SMA + Bollinger Bands";
let maLengthInput = input.int(
    14,
    @locale { default: "Length", "zh-CN": "周期", "zh-HK": "週期" },
    group: GRP,
    display: PlotDisplay.NONE,
    active: maTypeInput != "None"
);
let bbMultInput = input.float(
    2.0,
    @locale { default: "BB StdDev", "zh-CN": "BB 标准差", "zh-HK": "BB 標準差" },
    minval: 0.001,
    maxval: 50,
    step: 0.5,
    tooltip: TT_BB,
    group: GRP,
    display: PlotDisplay.NONE,
    active: isBB
);
var enableMA = maTypeInput != "None";

fn ma(source, length, MAtype) {
    switch MAtype {
        "SMA" => ta.sma(source, length),
        "SMA + Bollinger Bands" => ta.sma(source, length),
        "EMA" => ta.ema(source, length),
        "SMMA (RMA)" => ta.rma(source, length),
        "WMA" => ta.wma(source, length),
        "VWMA" => ta.vwma(source, length),
    }
}

let smoothingMA = enableMA ? ma(rsi, maLengthInput, maTypeInput) : na;
let smoothingStDev = isBB ? ta.stdev(rsi, maLengthInput) * bbMultInput : na;
plot(
    smoothingMA,
    @locale { default: "RSI-based MA", "zh-CN": "基于 RSI 的均线", "zh-HK": "基於 RSI 的均線" },
    color: Color.YELLOW,
    display: enableMA ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: enableMA
);
let bbUpperBand = plot(
    smoothingMA + smoothingStDev,
    title: @locale { default: "Upper Bollinger Band", "zh-CN": "布林带上轨", "zh-HK": "布林帶上軌" },
    color: Color.GREEN,
    display: isBB ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: isBB
);
let bbLowerBand = plot(
    smoothingMA - smoothingStDev,
    title: @locale { default: "Lower Bollinger Band", "zh-CN": "布林带下轨", "zh-HK": "布林帶下軌" },
    color: Color.GREEN,
    display: isBB ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: isBB
);
fill(
    bbUpperBand,
    bbLowerBand,
    color: isBB ? Color.new(Color.GREEN, 90) : na,
    title: @locale { default: "Bollinger Bands Background Fill", "zh-CN": "布林带背景填充", "zh-HK": "布林帶背景填充" },
    display: isBB ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: isBB
);

let lookbackRight = 5;
let lookbackLeft = 5;
let rangeUpper = 60;
let rangeLower = 5;
let bearColor = Color.RED;
let bullColor = Color.GREEN;
let textColor = Color.WHITE;
let noneColor = Color.new(Color.WHITE, 100);

fn _inRange(cond: bool) {
    let bars = ta.bars_since(cond);
    rangeLower <= bars and bars <= rangeUpper;
}

let plFound = false;
let phFound = false;

let bullCond = false;
let bearCond = false;

let rsiLBR = rsi[lookbackRight];

if calculateDivergence {
    plFound = not na(ta.pivot_low(rsi, lookbackLeft, lookbackRight));
    let rsiHL = rsiLBR > ta.value_when(plFound, rsiLBR, 1) and _inRange(
        plFound[1]
    );
    let lowLBR = low[lookbackRight];
    let priceLL = lowLBR < ta.value_when(plFound, lowLBR, 1);
    bullCond = priceLL and rsiHL and plFound;
    phFound = not na(ta.pivot_high(rsi, lookbackLeft, lookbackRight));
    let rsiLH = rsiLBR < ta.value_when(phFound, rsiLBR, 1) and _inRange(
        phFound[1]
    );
    let highLBR = high[lookbackRight];
    let priceHH = highLBR > ta.value_when(phFound, highLBR, 1);
    bearCond = priceHH and rsiLH and phFound;
}

plot(
    plFound ? rsiLBR : na,
    offset: -lookbackRight,
    title: @locale { default: "Regular Bullish", "zh-CN": "常规看涨", "zh-HK": "常規看漲" },
    line_width: 2,
    color: (bullCond ? bullColor : noneColor),
    display: PlotDisplay.PANE,
    editable: calculateDivergence
);

plot_shape(
    bullCond ? rsiLBR : na,
    offset: -lookbackRight,
    title: @locale { default: "Regular Bullish label", "zh-CN": "常规看涨标签", "zh-HK": "常規看漲標籤" },
    text: @locale { default: " Bull ", "zh-CN": " 多 ", "zh-HK": " 多 " },
    style: Shape.LabelUp,
    location: Location.Absolute,
    color: bullColor,
    text_color: textColor,
    display: PlotDisplay.PANE,
    editable: calculateDivergence
);

plot(
    phFound ? rsiLBR : na,
    offset: -lookbackRight,
    title: @locale { default: "Regular Bearish", "zh-CN": "常规看跌", "zh-HK": "常規看跌" },
    line_width: 2,
    color: (bearCond ? bearColor : noneColor),
    display: PlotDisplay.PANE,
    editable: calculateDivergence
);

plot_shape(
    bearCond ? rsiLBR : na,
    offset: -lookbackRight,
    title: @locale { default: "Regular Bearish label", "zh-CN": "常规看跌标签", "zh-HK": "常規看跌標籤" },
    text: @locale { default: " Bear ", "zh-CN": " 空 ", "zh-HK": " 空 " },
    style: Shape.LabelDown,
    location: Location.Absolute,
    color: bearColor,
    text_color: textColor,
    display: PlotDisplay.PANE,
    editable: calculateDivergence
);

alert_condition(
    bullCond,
    title: @locale { default: "Regular Bullish Divergence", "zh-CN": "常规看涨背离", "zh-HK": "常規看漲背離" },
    message: @locale {
        default: "Found a new Regular Bullish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar.",
        "zh-CN": "发现新的常规看涨背离，位于当前 K 线左侧 `Pivot Lookback Right` 根 K 线处。",
        "zh-HK": "發現新的常規看漲背離，位於當前 K 線左側 `Pivot Lookback Right` 根 K 線處。",
    }
);
alert_condition(
    bearCond,
    title: @locale { default: "Regular Bearish Divergence", "zh-CN": "常规看跌背离", "zh-HK": "常規看跌背離" },
    message: @locale {
        default: "Found a new Regular Bearish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar.",
        "zh-CN": "发现新的常规看跌背离，位于当前 K 线左侧 `Pivot Lookback Right` 根 K 线处。",
        "zh-HK": "發現新的常規看跌背離，位於當前 K 線左側 `Pivot Lookback Right` 根 K 線處。",
    }
);
