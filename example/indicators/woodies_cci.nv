indicator(title: @locale { default: "Woodies CCI", "zh-CN": "Woodies CCI", "zh-HK": "Woodies CCI" }, timeframe: "", timeframe_gaps: true);
let cciTurboLength = input.int(
    title: @locale { default: "CCI Turbo Length", "zh-CN": "CCI Turbo 周期", "zh-HK": "CCI Turbo 週期" },
    defval: 6,
    minval: 3,
    maxval: 14
);
let cci14Length = input.int(
    title: @locale { default: "CCI 14 Length", "zh-CN": "CCI 14 周期", "zh-HK": "CCI 14 週期" },
    defval: 14,
    minval: 7,
    maxval: 20
);
let source = close;
let cciTurbo = ta.cci(source, cciTurboLength);
let cci14 = ta.cci(source, cci14Length);
let last5IsDown = cci14[5] < 0 and cci14[4] < 0 and cci14[3] < 0 and cci14[2] < 0 and cci14[1] < 0;
let last5IsUp = cci14[5] > 0 and cci14[4] > 0 and cci14[3] > 0 and cci14[2] > 0 and cci14[1] > 0;
let histogramColor = last5IsUp ? #009688 : last5IsDown ? #F44336 : cci14 < 0 ? #009688 : #F44336;
plot(
    cci14,
    title: @locale { default: "CCI Turbo Histogram", "zh-CN": "CCI Turbo 柱状图", "zh-HK": "CCI Turbo 柱狀圖" },
    color: histogramColor,
    style: PlotStyle.Histogram
);
plot(cciTurbo, title: @locale { default: "CCI Turbo", "zh-CN": "CCI Turbo", "zh-HK": "CCI Turbo" }, color: #009688, style: PlotStyle.Line);
plot(cci14, title: @locale { default: "CCI 14", "zh-CN": "CCI 14", "zh-HK": "CCI 14" }, color: #F44336, style: PlotStyle.Line);
hline(0, title: @locale { default: "Zero line", "zh-CN": "零线", "zh-HK": "零線" }, color: #787B86, line_style: HLineStyle.Solid);
hline(100, title: @locale { default: "Hundred line", "zh-CN": "百线", "zh-HK": "百線" }, color: #787B86, line_style: HLineStyle.Dotted);
hline(-100, title: @locale { default: "Minus line", "zh-CN": "负百线", "zh-HK": "負百線" }, color: #787B86, line_style: HLineStyle.Dotted);
