indicator(
    title: @locale { default: "Connors RSI", "zh-CN": "Connors RSI", "zh-HK": "Connors RSI" },
    short_title: "CRSI",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);
let src = close;
let lenrsi = input(3, @locale { default: "RSI Length", "zh-CN": "RSI 周期", "zh-HK": "RSI 週期" });
let lenupdown = input(2, @locale { default: "UpDown Length", "zh-CN": "涨跌周期", "zh-HK": "漲跌週期" });
let lenroc = input(100, @locale { default: "ROC Length", "zh-CN": "ROC 周期", "zh-HK": "ROC 週期" });
fn updown(s) {
    let isEqual = s == s[1];
    let isGrowing = s > s[1];
    let ud = 0.0;
    ud = isEqual ? 0 : isGrowing ? (nz(ud[1]) <= 0 ? 1 : nz(ud[1]) + 1) : (nz(
        ud[1]
    ) >= 0 ? -1 : nz(ud[1]) - 1);
    ud;
}
let rsi = ta.rsi(src, lenrsi);
let updownrsi = ta.rsi(updown(src), lenupdown);
let percent_rank = ta.percent_rank(ta.roc(src, 1), lenroc);
let crsi = math.avg(rsi, updownrsi, percent_rank);
plot(crsi, @locale { default: "CRSI", "zh-CN": "CRSI", "zh-HK": "CRSI" }, #2962FF);
let band1 = hline(70, @locale { default: "Upper Band", "zh-CN": "上轨", "zh-HK": "上軌" }, color: #787B86);
hline(50, @locale { default: "Middle Band", "zh-CN": "中轨", "zh-HK": "中軌" }, color: Color.new(#787B86, 50));
let band0 = hline(30, @locale { default: "Lower Band", "zh-CN": "下轨", "zh-HK": "下軌" }, color: #787B86);
fill(band1, band0, Color.rgb(33, 150, 243, 90), title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" });
