indicator(
    title: "Stochastic RSI",
    short_title: "Stoch RSI",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);
let smoothK = input.int(3, @locale { default: "K", "zh-CN": "K", "zh-HK": "K" }, minval: 1);
let smoothD = input.int(3, @locale { default: "D", "zh-CN": "D", "zh-HK": "D" }, minval: 1);
let lengthRSI = input.int(14, @locale { default: "RSI Length", "zh-CN": "RSI 周期", "zh-HK": "RSI 週期" }, minval: 1);
let lengthStoch = input.int(14, @locale { default: "Stochastic Length", "zh-CN": "Stochastic 周期", "zh-HK": "Stochastic 週期" }, minval: 1);
let src = input(close, title: @locale { default: "RSI Source", "zh-CN": "RSI 数据源", "zh-HK": "RSI 數據源" });
let rsi1 = ta.rsi(src, lengthRSI);
let k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK);
let d = ta.sma(k, smoothD);
plot(k, @locale { default: "K", "zh-CN": "K", "zh-HK": "K" }, color: #2962FF);
plot(d, @locale { default: "D", "zh-CN": "D", "zh-HK": "D" }, color: #FF6D00);
let h0 = hline(80, @locale { default: "Upper Band", "zh-CN": "上轨", "zh-HK": "上軌" }, color: #787B86);
hline(50, @locale { default: "Middle Band", "zh-CN": "中轨", "zh-HK": "中軌" }, color: Color.new(#787B86, 50));
let h1 = hline(20, @locale { default: "Lower Band", "zh-CN": "下轨", "zh-HK": "下軌" }, color: #787B86);
fill(h0, h1, color: Color.rgb(33, 150, 243, 90), title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" });
