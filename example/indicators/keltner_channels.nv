indicator(
    title: @locale { default: "Keltner Channels", "zh-CN": "肯特纳通道", "zh-HK": "肯特納通道" },
    short_title: "KC",
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);
let length = input.int(20, minval: 1);
let mult = input(2.0, @locale { default: "Multiplier", "zh-CN": "乘数", "zh-HK": "乘數" });
let src = input(close, title: @locale { default: "Source", "zh-CN": "数据源", "zh-HK": "數據源" });
let exp = input(true, @locale { default: "Use Exponential MA", "zh-CN": "使用指数均线", "zh-HK": "使用指數均線" }, display: PlotDisplay.NONE);
let BandsStyle = input.string(
    "Average True Range",
    options: ["Average True Range", "True Range", "Range"],
    title: @locale { default: "Bands Style", "zh-CN": "通道样式", "zh-HK": "通道樣式" },
    display: PlotDisplay.NONE
);
let atrlength = input(10, @locale { default: "ATR Length", "zh-CN": "ATR 周期", "zh-HK": "ATR 週期" }, display: PlotDisplay.NONE);
fn esma(source, length) {
    let s = ta.sma(source, length);
    let e = ta.ema(source, length);
    exp ? e : s;
}
let ma = esma(src, length);
let rangema = BandsStyle == "True Range" ? ta.tr(true) : BandsStyle == "Average True Range" ? ta.atr(
    atrlength
) : ta.rma(high - low, length);
let upper = ma + rangema * mult;
let lower = ma - rangema * mult;
let u = plot(upper, color: #2962FF, title: @locale { default: "Upper", "zh-CN": "上轨", "zh-HK": "上軌" });
plot(ma, color: #2962FF, title: @locale { default: "Basis", "zh-CN": "中轨", "zh-HK": "中軌" });
let l = plot(lower, color: #2962FF, title: @locale { default: "Lower", "zh-CN": "下轨", "zh-HK": "下軌" });
fill(u, l, color: Color.rgb(33, 150, 243, 95), title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" });
