indicator(
    title: @locale { default: "SMI Ergodic Indicator", "zh-CN": "SMI 遍历指标", "zh-HK": "SMI 遍歷指標" },
    short_title: "SMII",
    format: Format.Price,
    precision: 4,
    timeframe: "",
    timeframe_gaps: true
);
let longlen = input.int(20, minval: 1, title: @locale { default: "Long Length", "zh-CN": "长周期", "zh-HK": "長週期" });
let shortlen = input.int(5, minval: 1, title: @locale { default: "Short Length", "zh-CN": "短周期", "zh-HK": "短週期" });
let siglen = input.int(5, minval: 1, title: @locale { default: "Signal line Length", "zh-CN": "信号线周期", "zh-HK": "信號線週期" });
let erg = ta.tsi(close, shortlen, longlen);
let sig = ta.ema(erg, siglen);
plot(erg, color: #2962FF, title: @locale { default: "SMI", "zh-CN": "SMI", "zh-HK": "SMI" });
plot(sig, color: #FF6D00, title: @locale { default: "Signal", "zh-CN": "信号线", "zh-HK": "信號線" });
