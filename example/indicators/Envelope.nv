indicator(
    title: @locale { default: "Envelope", "zh-CN": "包络线", "zh-HK": "包絡線" },
    short_title: "Env",
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);
let len = input.int(20, title: @locale { default: "Length", "zh-CN": "周期", "zh-HK": "週期" }, minval: 1);
let percent = input(10.0, @locale { default: "Percent", "zh-CN": "百分比", "zh-HK": "百分比" });
let src = input(close, title: @locale { default: "Source", "zh-CN": "数据源", "zh-HK": "數據源" });
let exponential = input(false, @locale { default: "Exponential", "zh-CN": "指数移动平均", "zh-HK": "指數移動平均" });
let basis = exponential ? ta.ema(src, len) : ta.sma(src, len);
let k = percent / 100.0;
let upper = basis * (1 + k);
let lower = basis * (1 - k);
plot(basis, @locale { default: "Basis", "zh-CN": "基准线", "zh-HK": "基準線" }, color: #FF6D00);
let u = plot(upper, @locale { default: "Upper", "zh-CN": "上轨", "zh-HK": "上軌" }, color: #2962FF);
let l = plot(lower, @locale { default: "Lower", "zh-CN": "下轨", "zh-HK": "下軌" }, color: #2962FF);
fill(u, l, color: Color.rgb(33, 150, 243, 95), title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" });
