indicator(
    title: @locale { default: "Williams Alligator", "zh-CN": "威廉鳄鱼", "zh-HK": "威廉鱷魚" },
    short_title: "Alligator",
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);
fn smma(src, length) {
    let smma = 0.0;
    smma = na(smma[1]) ? ta.sma(src, length) : (smma[1] * (length - 1) + src) / length;
    smma;
}
let jawLength = input.int(13, minval: 1, title: @locale { default: "Jaw Length", "zh-CN": "颚线周期", "zh-HK": "顎線週期" });
let teethLength = input.int(8, minval: 1, title: @locale { default: "Teeth Length", "zh-CN": "齿线周期", "zh-HK": "齒線週期" });
let lipsLength = input.int(5, minval: 1, title: @locale { default: "Lips Length", "zh-CN": "唇线周期", "zh-HK": "唇線週期" });
let jawOffset = input(8, title: @locale { default: "Jaw Offset", "zh-CN": "颚线偏移", "zh-HK": "顎線偏移" });
let teethOffset = input(5, title: @locale { default: "Teeth Offset", "zh-CN": "齿线偏移", "zh-HK": "齒線偏移" });
let lipsOffset = input(3, title: @locale { default: "Lips Offset", "zh-CN": "唇线偏移", "zh-HK": "唇線偏移" });
let jaw = smma(hl2, jawLength);
let teeth = smma(hl2, teethLength);
let lips = smma(hl2, lipsLength);
plot(jaw, @locale { default: "Jaw", "zh-CN": "颚线", "zh-HK": "顎線" }, offset: jawOffset, color: #2962FF);
plot(teeth, @locale { default: "Teeth", "zh-CN": "齿线", "zh-HK": "齒線" }, offset: teethOffset, color: #E91E63);
plot(lips, @locale { default: "Lips", "zh-CN": "唇线", "zh-HK": "唇線" }, offset: lipsOffset, color: #66BB6A);
