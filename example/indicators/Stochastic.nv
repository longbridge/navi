indicator(
    title: @locale { default: "Stochastic", "zh-CN": "随机指标", "zh-HK": "隨機指標" },
    short_title: "Stoch",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);
let periodK = input.int(14, title: @locale { default: "%K Length", "zh-CN": "%K 周期", "zh-HK": "%K 週期" }, minval: 1);
let smoothK = input.int(1, title: @locale { default: "%K Smoothing", "zh-CN": "%K 平滑", "zh-HK": "%K 平滑" }, minval: 1);
let periodD = input.int(3, title: @locale { default: "%D Smoothing", "zh-CN": "%D 平滑", "zh-HK": "%D 平滑" }, minval: 1);
let k = ta.sma(ta.stoch(close, high, low, periodK), smoothK);
let d = ta.sma(k, periodD);
plot(k, title: @locale { default: "%K", "zh-CN": "%K", "zh-HK": "%K" }, color: #2962FF);
plot(d, title: @locale { default: "%D", "zh-CN": "%D", "zh-HK": "%D" }, color: #FF6D00);
let h0 = hline(80, @locale { default: "Upper Band", "zh-CN": "上轨", "zh-HK": "上軌" }, color: #787B86);
hline(50, @locale { default: "Middle Band", "zh-CN": "中轨", "zh-HK": "中軌" }, color: Color.new(#787B86, 50));
let h1 = hline(20, @locale { default: "Lower Band", "zh-CN": "下轨", "zh-HK": "下軌" }, color: #787B86);
fill(h0, h1, color: Color.rgb(33, 150, 243, 90), title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" });
