indicator(@locale { default: "BBTrend", "zh-CN": "BB趋势", "zh-HK": "BB趨勢" }, timeframe: "", timeframe_gaps: true);

let shortLengthInput = input.int(20, @locale { default: "Short BB Length", "zh-CN": "短周期 BB 长度", "zh-HK": "短週期 BB 長度" }, minval: 1);
let longLengthInput = input.int(50, @locale { default: "Long BB Length", "zh-CN": "长周期 BB 长度", "zh-HK": "長週期 BB 長度" }, minval: 1);
let stdDevMultInput = input.float(2.0, @locale { default: "StdDev", "zh-CN": "标准差倍数", "zh-HK": "標準差倍數" }, minval: 0.001);

let (shortMiddle, shortUpper, shortLower) = ta.bb(
    close,
    shortLengthInput,
    stdDevMultInput
);
let (longMiddle, longUpper, longLower) = ta.bb(
    close,
    longLengthInput,
    stdDevMultInput
);

let BBTrend = (math.abs(shortLower - longLower) - math.abs(
    shortUpper - longUpper
)) / shortMiddle * 100;

let posColorStrong = Color.new(#089981, 25);
let negColorStrong = Color.new(#F23645, 25);
let posColorWeak = Color.new(#089981, 50);
let negColorWeak = Color.new(#F23645, 50);

let histColor = switch {
    BBTrend > 0 and BBTrend >= BBTrend[1] => posColorStrong,
    BBTrend > 0 and BBTrend < BBTrend[1] => posColorWeak,
    BBTrend < 0 and BBTrend > BBTrend[1] => negColorWeak,
    BBTrend < 0 and BBTrend <= BBTrend[1] => negColorStrong,
    => posColorWeak,
};
plot(BBTrend, @locale { default: "BBTrend", "zh-CN": "BB趋势", "zh-HK": "BB趨勢" }, style: PlotStyle.Columns, color: histColor);
hline(0, @locale { default: "Zero line", "zh-CN": "零线", "zh-HK": "零線" });
