indicator(
    title: @locale { default: "McGinley Dynamic", "zh-CN": "麦金利动态均线", "zh-HK": "麥金利動態均線" },
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);
let length = input.int(14, minval: 1);
let source = close;
let mg = 0.0;
mg = na(mg[1]) ? ta.ema(source, length) : mg[1] + (source - mg[1]) / (length * math.pow(
    source / mg[1],
    4
));
plot(mg, @locale { default: "McGinley Dynamic", "zh-CN": "麦金利动态均线", "zh-HK": "麥金利動態均線" });
