plot(close, @locale { default: "Close Price", "zh-CN": "收盘价", "zh-HK": "收盤價" }, color: #00BCD4);
indicator(
    title: @locale { default: "Rob Booker - Ziv Ghost Pivots", "zh-CN": "Rob Booker - Ziv 幽灵枢轴", "zh-HK": "Rob Booker - Ziv 幽靈樞軸" },
    short_title: @locale { default: "Ghost Pivots", "zh-CN": "幽灵枢轴", "zh-HK": "幽靈樞軸" },
    overlay: true
);
let s4 = input(true, title: @locale { default: "Show Next 4 HR Pivot", "zh-CN": "显示下一个4小时枢轴", "zh-HK": "顯示下一個4小時樞軸" });
let sd = input(true, title: @locale { default: "Show Next Day (8 HR) Pivot", "zh-CN": "显示下一个日线（8小时）枢轴", "zh-HK": "顯示下一個日線（8小時）樞軸" });
let sw = input(true, title: @locale { default: "Show Next Week Pivot", "zh-CN": "显示下一个周线枢轴", "zh-HK": "顯示下一個週線樞軸" });
let sm = input(true, title: @locale { default: "Show Next Month Pivot", "zh-CN": "显示下一个月线枢轴", "zh-HK": "顯示下一個月線樞軸" });
let fourHR_offset = 0;
let day_offset = 0;
let week_offset = 0;
let month_offset = 0;
let etime_pivot = sd == true ? request.security(
    symbol_info.tickerid,
    "240",
    hlc3[0],
    BarmergeGaps.Off,
    BarmergeLookahead.On
) : na;
let dtime_pivot = sd == true ? request.security(
    symbol_info.tickerid,
    "D",
    hlc3[0],
    BarmergeGaps.Off,
    BarmergeLookahead.On
) : na;
let wtime_pivot = sw == true ? request.security(
    symbol_info.tickerid,
    "W",
    hlc3[0],
    BarmergeGaps.Off,
    BarmergeLookahead.On
) : na;
let mtime_pivot = sm == true ? request.security(
    symbol_info.tickerid,
    "M",
    hlc3[0],
    BarmergeGaps.Off,
    BarmergeLookahead.On
) : na;
plot_char(
    etime_pivot,
    color: #00BCD4,
    char: "8",
    text: "",
    location: Location.Absolute,
    offset: fourHR_offset
);
plot_char(
    dtime_pivot,
    color: #2962FF,
    char: "d",
    text: "",
    location: Location.Absolute,
    offset: day_offset
);
plot_char(
    wtime_pivot,
    color: #673AB7,
    char: "w",
    text: "",
    location: Location.Absolute,
    offset: week_offset
);
plot_char(
    mtime_pivot,
    color: #E91E63,
    char: "m",
    text: "",
    location: Location.Absolute,
    offset: month_offset
);
