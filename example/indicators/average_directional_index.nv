indicator(
    @locale { default: "Average Directional Index", "zh-CN": "平均趋向指数", "zh-HK": "平均趨向指數" },
    short_title: "ADX",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);

let TT_ADX_LEN = @locale {
    default: "The time period to be used in calculating the ADX which has a smoothing component.",
    "zh-CN": "用于计算 ADX 的时间周期，ADX 包含平滑处理成分。",
    "zh-HK": "用於計算 ADX 的時間週期，ADX 包含平滑處理成分。",
};
let TT_DI_LEN = @locale {
    default: "The time period to be used in calculating the DI (Directional Indicator).",
    "zh-CN": "用于计算 DI（方向性指标）的时间周期。",
    "zh-HK": "用於計算 DI（方向性指標）的時間週期。",
};

let adxlen = input(14, title: @locale { default: "ADX Smoothing", "zh-CN": "ADX 平滑周期", "zh-HK": "ADX 平滑週期" }, tooltip: TT_ADX_LEN);
let dilen = input(14, title: @locale { default: "DI Length", "zh-CN": "DI 长度", "zh-HK": "DI 長度" }, tooltip: TT_DI_LEN);

fn dirmov(len) {
    let up = ta.change(high);
    let down = -ta.change(low);
    let plusDM = na(up) ? na : (up > down and up > 0 ? up : 0);
    let minusDM = na(down) ? na : (down > up and down > 0 ? down : 0);
    let truerange = ta.rma(ta.tr, len);
    let plus = fixnan(100 * ta.rma(plusDM, len) / truerange);
    let minus = fixnan(100 * ta.rma(minusDM, len) / truerange);
    (plus, minus);
}
fn adx(dilen, adxlen) {
    let (plus, minus) = dirmov(dilen);
    let sum = plus + minus;
    let adx = 100 * ta.rma(
        math.abs(plus - minus) / (sum == 0 ? 1 : sum),
        adxlen
    );
}
let sig = adx(dilen, adxlen);
plot(sig, color: Color.RED, title: @locale { default: "ADX", "zh-CN": "ADX", "zh-HK": "ADX" });
