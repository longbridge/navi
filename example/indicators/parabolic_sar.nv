indicator(
    title: @locale { default: "Parabolic SAR", "zh-CN": "抛物线 SAR", "zh-HK": "拋物線 SAR" },
    short_title: "SAR",
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);
let start = input(0.02);
let increment = input(0.02);
let maximum = input(0.2, @locale { default: "Max value", "zh-CN": "最大值", "zh-HK": "最大值" });
let out = ta.sar(start, increment, maximum);
plot(out, @locale { default: "ParabolicSAR", "zh-CN": "抛物线SAR", "zh-HK": "拋物線SAR" }, style: PlotStyle.Cross, color: #2962FF);
