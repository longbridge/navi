indicator(
    @locale { default: "Percentage Price Oscillator", "zh-CN": "百分比价格振荡器", "zh-HK": "百分比價格振盪器" },
    "PPO",
    false,
    Format.Percent,
    2,
    timeframe: "",
    timeframe_gaps: true
);

let sourceInput: float = input.source(close, @locale { default: "Source", "zh-CN": "数据源", "zh-HK": "數據源" });
let fastLenInput: int = input.int(12, @locale { default: "Fast length", "zh-CN": "快线周期", "zh-HK": "快線週期" }, 1);
let slowLenInput: int = input.int(26, @locale { default: "Slow length", "zh-CN": "慢线周期", "zh-HK": "慢線週期" }, 1);
let sigLenInput: int = input.int(9, @locale { default: "Signal length", "zh-CN": "信号线周期", "zh-HK": "信號線週期" }, 1);
let oscTypeInput: String = input.string(
    "EMA",
    @locale { default: "Oscillator MA type", "zh-CN": "振荡器均线类型", "zh-HK": "振盪器均線類型" },
    ["EMA", "SMA"],
    display: PlotDisplay.NONE
);
let sigTypeInput: String = input.string(
    "EMA",
    @locale { default: "Signal MA type", "zh-CN": "信号线均线类型", "zh-HK": "信號線均線類型" },
    ["EMA", "SMA"],
    display: PlotDisplay.NONE
);

fn ma(source: float, length: int, maType: simple String) {
    switch maType {
        "EMA" => ta.ema(source, length),
        "SMA" => ta.sma(source, length),
    }
}

let maFast: float = ma(sourceInput, fastLenInput, oscTypeInput);
let maSlow: float = ma(sourceInput, slowLenInput, oscTypeInput);
let ppo: float = 100.0 * (maFast - maSlow) / maSlow;
let signal: float = ma(ppo, sigLenInput, sigTypeInput);
let hist: float = ppo - signal;
let hColor: Color = hist >= 0 ? hist > hist[1] ? #26a69a : #b2dfdb : hist > hist[1] ? #ffcdd2 : #ff5252;

hline(0, @locale { default: "Zero", "zh-CN": "零轴", "zh-HK": "零軸" }, #787b8680);
plot(hist, @locale { default: "Histogram", "zh-CN": "柱状图", "zh-HK": "柱狀圖" }, hColor, style: PlotStyle.Columns);
plot(ppo, @locale { default: "PPO", "zh-CN": "PPO", "zh-HK": "PPO" });
plot(signal, @locale { default: "Signal line", "zh-CN": "信号线", "zh-HK": "信號線" }, #ff6d00);
