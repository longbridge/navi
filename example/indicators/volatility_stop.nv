indicator(
    @locale { default: "Volatility Stop", "zh-CN": "波动率止损", "zh-HK": "波動率止損" },
    "VStop",
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);
let length = input.int(20, @locale { default: "Length", "zh-CN": "周期", "zh-HK": "週期" }, minval: 2);
let src = input.source(close, @locale { default: "Source", "zh-CN": "数据源", "zh-HK": "數據源" });
let factor = input.float(2.0, @locale { default: "Multiplier", "zh-CN": "乘数", "zh-HK": "乘數" }, minval: 0.25, step: 0.25);
fn volStop(src, atrlen, atrfactor) {
    if not na(src) {
        var max = src;
        var min = src;
        var uptrend = true;
        var stop: float = na;
        let atrM = nz(ta.atr(atrlen) * atrfactor, ta.tr);
        max = math.max(max, src);
        min = math.min(min, src);
        stop = nz(
            uptrend ? math.max(stop, max - atrM) : math.min(stop, min + atrM),
            src
        );
        uptrend = src - stop >= 0.0;
        if uptrend != uptrend[1] and not bar_state.is_first {
            max = src;
            min = src;
            stop = uptrend ? max - atrM : min + atrM;
        }
        (stop, uptrend);
    }
}

let (vStop, uptrend) = volStop(src, length, factor);

plot(
    vStop,
    @locale { default: "Volatility Stop", "zh-CN": "波动率止损", "zh-HK": "波動率止損" },
    style: PlotStyle.Cross,
    color: uptrend ? #009688 : #F44336
);
