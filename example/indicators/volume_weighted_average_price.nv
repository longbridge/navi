indicator(
    title: @locale { default: "Volume Weighted Average Price", "zh-CN": "成交量加权平均价格", "zh-HK": "成交量加權平均價格" },
    short_title: "VWAP",
    overlay: true,
    timeframe: "",
    timeframe_gaps: true
);

let hideonDWM = input(
    false,
    title: @locale { default: "Hide VWAP on 1D or Above", "zh-CN": "在日线及以上周期隐藏 VWAP", "zh-HK": "在日線及以上週期隱藏 VWAP" },
    group: @locale { default: "VWAP Settings", "zh-CN": "VWAP 设置", "zh-HK": "VWAP 設置" },
    display: PlotDisplay.NONE
);
var anchor = input.string(
    defval: "Session",
    title: @locale { default: "Anchor Period", "zh-CN": "锚定周期", "zh-HK": "錨定週期" },
    options: [
        "Session",
        "Week",
        "Month",
        "Quarter",
        "Year",
        "Decade",
        "Century",
        "Earnings",
        "Dividends",
        "Splits"
    ],
    group: @locale { default: "VWAP Settings", "zh-CN": "VWAP 设置", "zh-HK": "VWAP 設置" }
);
let src = input(
    title: @locale { default: "Source", "zh-CN": "数据源", "zh-HK": "數據源" },
    defval: hlc3,
    group: @locale { default: "VWAP Settings", "zh-CN": "VWAP 设置", "zh-HK": "VWAP 設置" },
    display: PlotDisplay.NONE
);
let offset = input.int(
    0,
    title: @locale { default: "Offset", "zh-CN": "偏移量", "zh-HK": "偏移量" },
    group: @locale { default: "VWAP Settings", "zh-CN": "VWAP 设置", "zh-HK": "VWAP 設置" },
    display: PlotDisplay.NONE
);

let BANDS_GROUP = @locale { default: "Bands Settings", "zh-CN": "带状设置", "zh-HK": "帶狀設置" };
let CALC_MODE_TOOLTIP = @locale {
    default: "Determines the units used to calculate the distance of the bands. When 'Percentage' is selected, a multiplier of 1 means 1%.",
    "zh-CN": '决定用于计算带状距离的单位。选择"百分比"时，乘数 1 表示 1%。',
    "zh-HK": "決定用於計算帶狀距離的單位。選擇「百分比」時，乘數 1 表示 1%。",
};
let calcModeInput = input.string(
    "Standard Deviation",
    @locale { default: "Bands Calculation Mode", "zh-CN": "带状计算模式", "zh-HK": "帶狀計算模式" },
    options: ["Standard Deviation", "Percentage"],
    group: BANDS_GROUP,
    tooltip: CALC_MODE_TOOLTIP,
    display: PlotDisplay.NONE
);
let showBand_1 = input(
    true,
    title: "",
    group: BANDS_GROUP,
    inline: "band_1",
    display: PlotDisplay.NONE
);
let bandMult_1 = input.float(
    1.0,
    title: @locale { default: "Bands Multiplier #1", "zh-CN": "带状乘数 #1", "zh-HK": "帶狀乘數 #1" },
    group: BANDS_GROUP,
    inline: "band_1",
    step: 0.5,
    minval: 0,
    display: PlotDisplay.NONE,
    active: showBand_1
);
let showBand_2 = input(
    false,
    title: "",
    group: BANDS_GROUP,
    inline: "band_2",
    display: PlotDisplay.NONE
);
let bandMult_2 = input.float(
    2.0,
    title: @locale { default: "Bands Multiplier #2", "zh-CN": "带状乘数 #2", "zh-HK": "帶狀乘數 #2" },
    group: BANDS_GROUP,
    inline: "band_2",
    step: 0.5,
    minval: 0,
    display: PlotDisplay.NONE,
    active: showBand_2
);
let showBand_3 = input(
    false,
    title: "",
    group: BANDS_GROUP,
    inline: "band_3",
    display: PlotDisplay.NONE
);
let bandMult_3 = input.float(
    3.0,
    title: @locale { default: "Bands Multiplier #3", "zh-CN": "带状乘数 #3", "zh-HK": "帶狀乘數 #3" },
    group: BANDS_GROUP,
    inline: "band_3",
    step: 0.5,
    minval: 0,
    display: PlotDisplay.NONE,
    active: showBand_3
);

let cumVolume = ta.cum(volume);
if bar_state.is_last and cumVolume == 0 {
    runtime.error("No volume is provided by the data vendor.");
}

let isNewPeriod = switch anchor {
    "Earnings" => {
        let new_earnings_actual = request.earnings(
            symbol_info.tickerid,
            EarningsField.Actual,
            BarmergeGaps.On,
            BarmergeLookahead.On,
            ignore_invalid_symbol: true
        );
        let new_earnings_standardized = request.earnings(
            symbol_info.tickerid,
            EarningsField.Standardized,
            BarmergeGaps.On,
            BarmergeLookahead.On,
            ignore_invalid_symbol: true
        );
        not na(new_earnings_actual) or not na(new_earnings_standardized);
    }
    "Dividends" => {
        let new_dividends = request.dividends(
            symbol_info.tickerid,
            DividendsField.Gross,
            BarmergeGaps.On,
            BarmergeLookahead.On,
            ignore_invalid_symbol: true
        );
        not na(new_dividends);
    }
    "Splits" => {
        let new_split = request.splits(
            symbol_info.tickerid,
            SplitsField.Denominator,
            BarmergeGaps.On,
            BarmergeLookahead.On,
            ignore_invalid_symbol: true
        );
        not na(new_split);
    }
    "Session" => timeframe.change("D"),
    "Week" => timeframe.change("W"),
    "Month" => timeframe.change("M"),
    "Quarter" => timeframe.change("3M"),
    "Year" => timeframe.change("12M"),
    "Decade" => timeframe.change("12M") and year % 10 == 0,
    "Century" => timeframe.change("12M") and year % 100 == 0,
    => false,
};
let isEsdAnchor = anchor == "Earnings" or anchor == "Dividends" or anchor == "Splits";
if na(src[1]) and not isEsdAnchor {
    isNewPeriod = true;
}

let vwapValue: float = na;
let upperBandValue1: float = na;
let lowerBandValue1: float = na;
let upperBandValue2: float = na;
let lowerBandValue2: float = na;
let upperBandValue3: float = na;
let lowerBandValue3: float = na;

if not (hideonDWM and timeframe.is_dwm) {
    let (_vwap, _stdevUpper, _) = ta.vwap(src, isNewPeriod, 1);
    vwapValue = _vwap;
    let stdevAbs = _stdevUpper - _vwap;
    let bandBasis = calcModeInput == "Standard Deviation" ? stdevAbs : _vwap * 0.01;
    upperBandValue1 = _vwap + bandBasis * bandMult_1;
    lowerBandValue1 = _vwap - bandBasis * bandMult_1;
    upperBandValue2 = _vwap + bandBasis * bandMult_2;
    lowerBandValue2 = _vwap - bandBasis * bandMult_2;
    upperBandValue3 = _vwap + bandBasis * bandMult_3;
    lowerBandValue3 = _vwap - bandBasis * bandMult_3;
}

plot(vwapValue, title: "VWAP", color: #2962FF, offset:);

let displayBand1 = showBand_1 ? PlotDisplay.ALL : PlotDisplay.NONE;
let upperBand_1 = plot(
    upperBandValue1,
    title: @locale { default: "Upper Band #1", "zh-CN": "上轨 #1", "zh-HK": "上軌 #1" },
    color: Color.GREEN,
    offset:,
    display: displayBand1,
    editable: showBand_1
);
let lowerBand_1 = plot(
    lowerBandValue1,
    title: @locale { default: "Lower Band #1", "zh-CN": "下轨 #1", "zh-HK": "下軌 #1" },
    color: Color.GREEN,
    offset:,
    display: displayBand1,
    editable: showBand_1
);
fill(
    upperBand_1,
    lowerBand_1,
    title: @locale { default: "Bands Fill #1", "zh-CN": "带状填充 #1", "zh-HK": "帶狀填充 #1" },
    color: Color.new(Color.GREEN, 95),
    display: displayBand1,
    editable: showBand_1
);

let displayBand2 = showBand_2 ? PlotDisplay.ALL : PlotDisplay.NONE;
let upperBand_2 = plot(
    upperBandValue2,
    title: @locale { default: "Upper Band #2", "zh-CN": "上轨 #2", "zh-HK": "上軌 #2" },
    color: Color.OLIVE,
    offset:,
    display: displayBand2,
    editable: showBand_2
);
let lowerBand_2 = plot(
    lowerBandValue2,
    title: @locale { default: "Lower Band #2", "zh-CN": "下轨 #2", "zh-HK": "下軌 #2" },
    color: Color.OLIVE,
    offset:,
    display: displayBand2,
    editable: showBand_2
);
fill(
    upperBand_2,
    lowerBand_2,
    title: @locale { default: "Bands Fill #2", "zh-CN": "带状填充 #2", "zh-HK": "帶狀填充 #2" },
    color: Color.new(Color.OLIVE, 95),
    display: displayBand2,
    editable: showBand_2
);

let displayBand3 = showBand_3 ? PlotDisplay.ALL : PlotDisplay.NONE;
let upperBand_3 = plot(
    upperBandValue3,
    title: @locale { default: "Upper Band #3", "zh-CN": "上轨 #3", "zh-HK": "上軌 #3" },
    color: Color.TEAL,
    offset:,
    display: displayBand3,
    editable: showBand_3
);
let lowerBand_3 = plot(
    lowerBandValue3,
    title: @locale { default: "Lower Band #3", "zh-CN": "下轨 #3", "zh-HK": "下軌 #3" },
    color: Color.TEAL,
    offset:,
    display: displayBand3,
    editable: showBand_3
);
fill(
    upperBand_3,
    lowerBand_3,
    title: @locale { default: "Bands Fill #3", "zh-CN": "带状填充 #3", "zh-HK": "帶狀填充 #3" },
    color: Color.new(Color.TEAL, 95),
    display: displayBand3,
    editable: showBand_3
);
