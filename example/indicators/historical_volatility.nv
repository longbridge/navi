indicator(
    title: @locale { default: "Historical Volatility", "zh-CN": "历史波动率", "zh-HK": "歷史波動率" },
    short_title: "HV",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);
let length = input.int(10, minval: 1);
let annual = 365;
let per = timeframe.is_intraday or timeframe.is_daily and timeframe.multiplier == 1 ? 1 : 7;
let hv = 100 * ta.stdev(math.log(close / close[1]), length) * math.sqrt(
    annual / per
);
plot(hv, @locale { default: "HV", "zh-CN": "历史波动率", "zh-HK": "歷史波動率" }, color: #2962FF);
