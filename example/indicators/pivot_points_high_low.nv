indicator(
    @locale { default: "Pivot Points High Low", "zh-CN": "枢轴点高低", "zh-HK": "樞軸點高低" },
    short_title: "Pivots HL",
    overlay: true,
    max_labels_count: 500
);

let lengthGroupTitle = @locale { default: "LENGTH LEFT / RIGHT", "zh-CN": "左/右长度", "zh-HK": "左/右長度" };
let colorGroupTitle = @locale { default: "Text Color / label Color", "zh-CN": "文字颜色 / 标签颜色", "zh-HK": "文字顏色 / 標籤顏色" };
let leftLenH = input.int(
    title: @locale { default: "Pivot High", "zh-CN": "枢轴高点", "zh-HK": "樞軸高點" },
    defval: 10,
    minval: 1,
    inline: "Pivot High",
    group: lengthGroupTitle
);
let rightLenH = input.int(
    title: "/",
    defval: 10,
    minval: 1,
    inline: "Pivot High",
    group: lengthGroupTitle
);
let textColorH = input(
    title: @locale { default: "Pivot High", "zh-CN": "枢轴高点", "zh-HK": "樞軸高點" },
    defval: Color.BLACK,
    inline: "Pivot High",
    group: colorGroupTitle
);
let labelColorH = input(
    title: "",
    defval: Color.WHITE,
    inline: "Pivot High",
    group: colorGroupTitle
);

let leftLenL = input.int(
    title: @locale { default: "Pivot Low", "zh-CN": "枢轴低点", "zh-HK": "樞軸低點" },
    defval: 10,
    minval: 1,
    inline: "Pivot Low",
    group: lengthGroupTitle
);
let rightLenL = input.int(
    title: "/",
    defval: 10,
    minval: 1,
    inline: "Pivot Low",
    group: lengthGroupTitle
);
let textColorL = input(
    title: @locale { default: "Pivot Low", "zh-CN": "枢轴低点", "zh-HK": "樞軸低點" },
    defval: Color.BLACK,
    inline: "Pivot Low",
    group: colorGroupTitle
);
let labelColorL = input(
    title: "",
    defval: Color.WHITE,
    inline: "Pivot Low",
    group: colorGroupTitle
);

let ph = ta.pivot_high(leftLenH, rightLenH);
let pl = ta.pivot_low(leftLenL, rightLenL);

fn drawLabel(_offset, _pivot, _style, _color, _textColor) {
    if not na(_pivot) {
        Label.new(
            bar_index[_offset],
            _pivot,
            String.from(_pivot, Format.Mintick),
            style: _style,
            color: _color,
            text_color: _textColor
        );
    }
}

drawLabel(rightLenH, ph, LabelStyle.Down, labelColorH, textColorH);
drawLabel(rightLenL, pl, LabelStyle.Up, labelColorL, textColorL);
