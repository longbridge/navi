indicator(
    title: @locale { default: "Commodity Channel Index", "zh-CN": "商品通道指数", "zh-HK": "商品通道指數" },
    short_title: "CCI",
    format: Format.Price,
    precision: 2,
    timeframe: "",
    timeframe_gaps: true
);
let length = input.int(20, minval: 1);
let src = input(hlc3, title: @locale { default: "Source", "zh-CN": "数据源", "zh-HK": "數據源" });
let ma = ta.sma(src, length);
let cci = (src - ma) / (0.015 * ta.dev(src, length));
plot(cci, "CCI", color: #2962FF);
let band1 = hline(
    100,
    @locale { default: "Upper Band", "zh-CN": "上轨", "zh-HK": "上軌" },
    color: #787B86,
    line_style: HLineStyle.Dashed
);
hline(0, @locale { default: "Middle Band", "zh-CN": "中轨", "zh-HK": "中軌" }, color: Color.new(#787B86, 50));
let band0 = hline(
    -100,
    @locale { default: "Lower Band", "zh-CN": "下轨", "zh-HK": "下軌" },
    color: #787B86,
    line_style: HLineStyle.Dashed
);
fill(band1, band0, color: Color.rgb(33, 150, 243, 90), title: @locale { default: "Background", "zh-CN": "背景", "zh-HK": "背景" });

let GRP = @locale { default: "Smoothing", "zh-CN": "平滑处理", "zh-HK": "平滑處理" };
let TT_BB = @locale {
    default: "Only applies when 'SMA + Bollinger Bands' is selected. Determines the distance between the SMA and the bands.",
    "zh-CN": '仅在选择"SMA + 布林带"时适用。用于确定 SMA 与布林带之间的距离。',
    "zh-HK": "僅在選擇「SMA + 布林帶」時適用。用於確定 SMA 與布林帶之間的距離。",
};
let maTypeInput = input.string(
    "SMA",
    @locale { default: "Type", "zh-CN": "类型", "zh-HK": "類型" },
    options: [
        "None",
        "SMA",
        "SMA + Bollinger Bands",
        "EMA",
        "SMMA (RMA)",
        "WMA",
        "VWMA"
    ],
    group: GRP,
    display: PlotDisplay.NONE
);
var isBB = maTypeInput == "SMA + Bollinger Bands";
let maLengthInput = input.int(
    14,
    @locale { default: "Length", "zh-CN": "周期", "zh-HK": "週期" },
    group: GRP,
    display: PlotDisplay.NONE,
    active: maTypeInput != "None"
);
let bbMultInput = input.float(
    2.0,
    @locale { default: "BB StdDev", "zh-CN": "BB 标准差", "zh-HK": "BB 標準差" },
    minval: 0.001,
    maxval: 50,
    step: 0.5,
    tooltip: TT_BB,
    group: GRP,
    display: PlotDisplay.NONE,
    active: isBB
);
var enableMA = maTypeInput != "None";

fn ma(source, length, MAtype) {
    switch MAtype {
        "SMA" => ta.sma(source, length),
        "SMA + Bollinger Bands" => ta.sma(source, length),
        "EMA" => ta.ema(source, length),
        "SMMA (RMA)" => ta.rma(source, length),
        "WMA" => ta.wma(source, length),
        "VWMA" => ta.vwma(source, length),
    }
}

let smoothingMA = enableMA ? ma(cci, maLengthInput, maTypeInput) : na;
let smoothingStDev = isBB ? ta.stdev(cci, maLengthInput) * bbMultInput : na;
plot(
    smoothingMA,
    @locale { default: "CCI-based MA", "zh-CN": "基于 CCI 的均线", "zh-HK": "基於 CCI 的均線" },
    color: Color.YELLOW,
    display: enableMA ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: enableMA
);
let bbUpperBand = plot(
    smoothingMA + smoothingStDev,
    title: @locale { default: "Upper Bollinger Band", "zh-CN": "布林带上轨", "zh-HK": "布林帶上軌" },
    color: Color.GREEN,
    display: isBB ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: isBB
);
let bbLowerBand = plot(
    smoothingMA - smoothingStDev,
    title: @locale { default: "Lower Bollinger Band", "zh-CN": "布林带下轨", "zh-HK": "布林帶下軌" },
    color: Color.GREEN,
    display: isBB ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: isBB
);
fill(
    bbUpperBand,
    bbLowerBand,
    color: isBB ? Color.new(Color.GREEN, 90) : na,
    title: @locale { default: "Bollinger Bands Background Fill", "zh-CN": "布林带背景填充", "zh-HK": "布林帶背景填充" },
    display: isBB ? PlotDisplay.ALL : PlotDisplay.NONE,
    editable: isBB
);
