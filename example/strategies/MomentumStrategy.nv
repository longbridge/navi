strategy(@locale { default: "Momentum Strategy", "zh-CN": "动量策略", "zh-HK": "動量策略" }, overlay: true);
let length = input(12);
let price = close;
fn momentum(seria, length) {
    let mom = seria - seria[length];
    mom;
}
let mom0 = momentum(price, length);
let mom1 = momentum(mom0, 1);
if (mom0 > 0 and mom1 > 0) {
    strategy.entry(
        "MomLE",
        Direction.Long,
        stop: high + symbol_info.min_tick,
        comment: @locale { default: "MomLE", "zh-CN": "动量多头入场", "zh-HK": "動量多頭入場" }
    );
} else {
    strategy.cancel("MomLE");
}
if (mom0 < 0 and mom1 < 0) {
    strategy.entry(
        "MomSE",
        Direction.Short,
        stop: low - symbol_info.min_tick,
        comment: @locale { default: "MomSE", "zh-CN": "动量空头入场", "zh-HK": "動量空頭入場" }
    );
} else {
    strategy.cancel("MomSE");
}
