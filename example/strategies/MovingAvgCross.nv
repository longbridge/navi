strategy(@locale { default: "MovingAvg Cross", "zh-CN": "均线交叉", "zh-HK": "均線交叉" }, overlay: true);
let length = input(9, @locale { default: "Length", "zh-CN": "周期", "zh-HK": "週期" });
let confirmBars = input(1, @locale { default: "Confirm bars", "zh-CN": "确认K线数", "zh-HK": "確認K線數" });
let price = close;
let ma = ta.sma(price, length);
let bcond = price > ma;
let bcount = 0;
bcount = bcond ? nz(bcount[1]) + 1 : 0;
if (bcount == confirmBars) {
    strategy.entry("MACrossLE", Direction.Long, comment: "MACrossLE");
}
let scond = price < ma;
let scount = 0;
scount = scond ? nz(scount[1]) + 1 : 0;
if (scount == confirmBars) {
    strategy.entry("MACrossSE", Direction.Short, comment: "MACrossSE");
}
