strategy(
    @locale {
        default: "InSide Bar Strategy",
        "zh-CN": "内部K线策略",
        "zh-HK": "內部K線策略"
    },
    default_qty_type: DefaultQtyType.PercentOfEquity,
    default_qty_value: 10,
    overlay: true
);
if (high < high[1] and low > low[1]) {
    if (close > open) {
        strategy.entry("InsBarLE", Direction.Long, comment: "InsBarLE");
    }
    if (close < open) {
        strategy.entry("InsBarSE", Direction.Short, comment: "InsBarSE");
    }
}
