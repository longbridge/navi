strategy(@locale { default: "Consecutive Up/Down Strategy", "zh-CN": "连续上涨/下跌策略", "zh-HK": "連續上漲/下跌策略" }, overlay: true);
let consecutiveBarsUp = input(3, @locale { default: "Consecutive bars up", "zh-CN": "连续上涨K线数", "zh-HK": "連續上漲K線數" });
let consecutiveBarsDown = input(3, @locale { default: "Consecutive bars down", "zh-CN": "连续下跌K线数", "zh-HK": "連續下跌K線數" });
let price = close;
let ups = 0.0;
ups = price > price[1] ? nz(ups[1]) + 1 : 0;
let dns = 0.0;
dns = price < price[1] ? nz(dns[1]) + 1 : 0;
if (ups >= consecutiveBarsUp) {
    strategy.entry("ConsUpLE", Direction.Long, comment: "ConsUpLE");
}
if (dns >= consecutiveBarsDown) {
    strategy.entry("ConsDnSE", Direction.Short, comment: "ConsUpLE");
}
