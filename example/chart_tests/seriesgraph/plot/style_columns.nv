// 正确结果：蓝色 Columns 与红色 Histogram 绘制同一数据，
// 对比两者矩形宽度与间距的视觉差异
indicator("Chart Test: plot/style_columns", overlay: false);

let val = close - open;
let step = ta.atr(14) * 0.3;
plot(val + step, "Columns",   style: PlotStyle.Columns,   color: Color.BLUE);
plot(val - step, "Histogram", style: PlotStyle.Histogram, color: Color.RED);
