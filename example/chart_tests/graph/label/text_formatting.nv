// 正确结果：最后一根柱附近四个标签，文本依次为普通体 / 粗体 / 斜体 / 粗斜体
indicator("Chart Test: graph/label/text_formatting", overlay: true, max_labels_count: 10);

if bar_state.is_last {
    Label.new(bar_index - 9, close * 1.02, "Normal",
        style: LabelStyle.LabelCenter, color: Color.BLUE, text_color: Color.WHITE,
        text_formatting: TextFormat.NONE);
    Label.new(bar_index - 6, close * 1.02, "Bold",
        style: LabelStyle.LabelCenter, color: Color.GREEN, text_color: Color.WHITE,
        text_formatting: TextFormat.BOLD);
    Label.new(bar_index - 3, close * 1.02, "Italic",
        style: LabelStyle.LabelCenter, color: Color.ORANGE, text_color: Color.WHITE,
        text_formatting: TextFormat.ITALIC);
    Label.new(bar_index,     close * 1.02, "Bold+Italic",
        style: LabelStyle.LabelCenter, color: Color.RED, text_color: Color.WHITE,
        text_formatting: TextFormat.BOLD + TextFormat.ITALIC);
}
