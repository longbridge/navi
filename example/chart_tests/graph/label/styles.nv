    Label.new(bar_index - 30, close, "Center",  style: LabelStyle.LabelCenter,   color: Color.PURPLE, text_color: Color.WHITE);
    Label.new(bar_index - 28, close, "LL",      style: LabelStyle.LowerLeft,  color: Color.RED,    text_color: Color.WHITE);
    Label.new(bar_index - 26, close, "LR",      style: LabelStyle.LowerRight, color: Color.GREEN,  text_color: Color.WHITE);
    Label.new(bar_index - 24, close, "UL",      style: LabelStyle.UpperLeft,  color: Color.BLUE,   text_color: Color.WHITE);
    Label.new(bar_index - 22, close, "UR",      style: LabelStyle.UpperRight, color: Color.ORANGE, text_color: Color.WHITE);
    Label.new(bar_index - 20, close, "ArrD",    style: LabelStyle.ArrowDown,     color: Color.RED,    text_color: Color.WHITE);
    Label.new(bar_index - 18, close, "ArrU",    style: LabelStyle.ArrowUp,       color: Color.GREEN,  text_color: Color.WHITE);
    Label.new(bar_index - 16, close, "Circle",  style: LabelStyle.Circle,        color: Color.PURPLE, text_color: Color.WHITE);
    Label.new(bar_index - 14, close, "Cross",   style: LabelStyle.Cross,         color: Color.RED,    text_color: Color.WHITE);
    Label.new(bar_index - 12, close, "Diamond", style: LabelStyle.Diamond,       color: Color.GREEN,  text_color: Color.WHITE);
    Label.new(bar_index - 10, close, "Flag",    style: LabelStyle.Flag,          color: Color.BLUE,   text_color: Color.WHITE);
    Label.new(bar_index - 8,  close, "Square",  style: LabelStyle.Square,        color: Color.ORANGE, text_color: Color.WHITE);
