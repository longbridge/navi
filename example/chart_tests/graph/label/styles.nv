// 正确结果：最后一根柱附近依次展示 Down/Up/Left/Right/Circle/Flag/Diamond/Square/TriangleDown/TriangleUp/XCross 共 11 种标签样式
indicator("Chart Test: graph/label/styles", overlay: true, max_labels_count: 20);

if bar_state.is_last {
    Label.new(bar_index - 10, close * 1.01, "Down",    style: LabelStyle.Down,         color: Color.RED,    text_color: Color.WHITE);
    Label.new(bar_index - 9,  close * 0.99, "Up",      style: LabelStyle.Up,           color: Color.GREEN,  text_color: Color.WHITE);
    Label.new(bar_index - 8,  close,        "Left",    style: LabelStyle.Left,         color: Color.BLUE,   text_color: Color.WHITE);
    Label.new(bar_index - 7,  close,        "Right",   style: LabelStyle.Right,        color: Color.ORANGE, text_color: Color.WHITE);
    Label.new(bar_index - 6,  close,        "Circle",  style: LabelStyle.Circle,       color: Color.PURPLE, text_color: Color.WHITE);
    Label.new(bar_index - 5,  close,        "Flag",    style: LabelStyle.Flag,         color: Color.RED,    text_color: Color.WHITE);
    Label.new(bar_index - 4,  close,        "Diamond", style: LabelStyle.Diamond,      color: Color.GREEN,  text_color: Color.WHITE);
    Label.new(bar_index - 3,  close,        "Square",  style: LabelStyle.Square,       color: Color.BLUE,   text_color: Color.WHITE);
    Label.new(bar_index - 2,  close,        "TriD",    style: LabelStyle.TriangleDown, color: Color.ORANGE, text_color: Color.WHITE);
    Label.new(bar_index - 1,  close,        "TriU",    style: LabelStyle.TriangleUp,   color: Color.PURPLE, text_color: Color.WHITE);
    Label.new(bar_index,      close,        "XCross",  style: LabelStyle.XCross,       color: Color.YELLOW, text_color: Color.BLACK);
}
