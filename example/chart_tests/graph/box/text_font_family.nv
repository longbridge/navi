// 正确结果：最后一段两个带文字矩形——默认字体 Default / 等宽字体 Mono
indicator("Chart Test: graph/box/text_font_family", overlay: true, max_boxes_count: 10);

let h = ta.highest(high, 20);
let l = ta.lowest(low, 20);

if bar_state.is_last {
    Box.new(bar_index - 20, h, bar_index - 11, l,
        bg_color: Color.new(Color.BLUE, 85), border_color: Color.BLUE, border_width: 1,
        text: "Default 0123", text_color: Color.WHITE, text_size: 16,
        text_font_family: FontFamily.Default);
    Box.new(bar_index - 10, h, bar_index, l,
        bg_color: Color.new(Color.ORANGE, 85), border_color: Color.ORANGE, border_width: 1,
        text: "Mono 0123", text_color: Color.WHITE, text_size: 16,
        text_font_family: FontFamily.Monospace);
}
