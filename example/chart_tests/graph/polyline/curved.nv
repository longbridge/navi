// 正确结果：连接最近 20 根柱收盘价的蓝色平滑曲线（curved: true），与折线形态相比过渡更圆滑
indicator("Chart Test: graph/polyline/curved", overlay: true);

if bar_state.is_last {
    let pts = Array.new<chart.Point>();
    for i = 0 to 19 {
        pts.push(chart.Point.from_index(bar_index - 19 + i, close[19 - i]));
    }
    Polyline.new(pts, curved: true, line_color: Color.BLUE, line_width: 2);
}
